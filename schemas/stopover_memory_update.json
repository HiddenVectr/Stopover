{
  "$defs": {
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "default": "Summary of context available to the source agent.",
          "title": "Basis",
          "type": "string"
        },
        "omitted": {
          "items": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Omitted",
          "type": "array"
        }
      },
      "title": "Coverage",
      "type": "object"
    },
    "MemoryEntry": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "description": "Stable topic key, e.g. communication.response_length. Reuse the existing key when correcting a memory.",
          "title": "Key",
          "type": "string"
        },
        "expected_revision": {
          "description": "0 for a new key; otherwise the revision returned by stopover_memory_read (for a forgotten key, its deletion-marker revision together with recreate=true).",
          "minimum": 0,
          "title": "Expected Revision",
          "type": "integer"
        },
        "content": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "category": {
          "default": "fact",
          "enum": [
            "fact",
            "preference",
            "habit",
            "goal",
            "project_context"
          ],
          "title": "Category",
          "type": "string"
        },
        "basis": {
          "default": "stated",
          "enum": [
            "stated",
            "observed",
            "inferred"
          ],
          "title": "Basis",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/Source"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Original evidence source; defaults to the updating client. Kept unchanged when the content is unchanged."
        },
        "evidence": {
          "default": "",
          "maxLength": 2048,
          "title": "Evidence",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "description": "UTC date (2026-12-31) or date-time with a timezone",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When this stops being true. Set it for anything time-bound (a deadline, a temporary situation); leave it out for lasting preferences and facts. Expired memories are left out of reads.",
          "title": "Expires At"
        },
        "recreate": {
          "default": false,
          "description": "Re-establish a forgotten key. Only when the user has just freshly stated this memory, never from an old copy.",
          "title": "Recreate",
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "expected_revision",
        "content"
      ],
      "title": "MemoryEntry",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "client": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Client",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "conversation_ref": {
          "anyOf": [
            {
              "maxLength": 8192,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conversation Ref"
        },
        "captured_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Captured At"
        },
        "authoring_method": {
          "default": "agent_summary",
          "enum": [
            "agent_summary",
            "human_summary"
          ],
          "title": "Authoring Method",
          "type": "string"
        },
        "transfer_method": {
          "default": "direct_mcp",
          "enum": [
            "direct_mcp",
            "manual_import",
            "local_test"
          ],
          "title": "Transfer Method",
          "type": "string"
        }
      },
      "required": [
        "client"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "operation_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Operation Id"
    },
    "client": {
      "description": "Harness making this update, e.g. codex or claude-code.",
      "maxLength": 160,
      "minLength": 1,
      "title": "Client",
      "type": "string"
    },
    "memories": {
      "items": {
        "$ref": "#/$defs/MemoryEntry"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Memories",
      "type": "array"
    },
    "partial": {
      "default": false,
      "description": "Apply entries that do not conflict and report the rest as action=conflict, instead of rejecting the whole batch.",
      "title": "Partial",
      "type": "boolean"
    },
    "coverage": {
      "$ref": "#/$defs/Coverage"
    }
  },
  "required": [
    "client",
    "memories"
  ],
  "title": "MemoryUpdate",
  "type": "object"
}
