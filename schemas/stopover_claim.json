{
  "additionalProperties": false,
  "properties": {
    "operation_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Operation Id"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "expected_revision": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Revision"
    },
    "action": {
      "default": "acquire",
      "enum": [
        "acquire",
        "renew",
        "release"
      ],
      "title": "Action",
      "type": "string"
    },
    "holder_label": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Holder Label"
    },
    "lease_seconds": {
      "anyOf": [
        {
          "maximum": 86400,
          "minimum": 60,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lease Seconds"
    },
    "claim_token": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 32,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Claim Token"
    },
    "claim_generation": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Claim Generation"
    }
  },
  "required": [
    "id"
  ],
  "title": "Claim",
  "type": "object"
}
